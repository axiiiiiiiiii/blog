---
import BaseLayout from '../layouts/BaseLayout.astro';
const pageTitle = "About Me";
const identity = {
    firstName: "Axi",
    country: "Vietnam",
    occupation: "Student",
    hobbies: ["robotics", "gaming", "programming", "volleyball"]
};

const skills = ["Python", "C#", "JS", "HTML", "CSS", "Astro", "Unity", "Pygame", "Pyqt"];

const skillColor = "red";
const fontWeight = "bold";
const textCase = "uppercase";
import Footer from '../components/Footer.astro';
---

<BaseLayout pageTitle={pageTitle}>
       <h2>... and my new website built with Astro.</h2>

        <p>I am working on building a blog using the Astro framework. </p>
        <p>This site will update as i lean more about Astros features.</p>

        <p>Here are a few facts about me:</p>
        <ul>
            <li class="items">My name is {identity.firstName}.</li>
            <li class="items">I live in {identity.country} and i am a {identity.occupation}.</li>
            <li class="items">My hobbies are:</li>
            <ul>
                 {identity.hobbies.length >= 2 &&
                identity.hobbies.map((hobby) => <li>{hobby}</li>)
                }   
            </ul>
        </ul>
        <p>My skills are:</p>
        <ul>
            { skills.map((skill) => <li class="skill">{skill}</li>)}  
        </ul>
    <!-- Page-specific Styles -->
    <style define:vars={{skillColor, fontWeight, textCase}}>
        .skill{
            color: var(--skillColor);
            font-weight: var(--fontWeight, "bold");
            text-transform: var(--textCase, "uppercase");
        }
    </style>
    <!-- Styles that must affect layout elements (like the h1) -->
    <!-- global : overwrite -->
    <style is:global> 
        h1{
            color: purple;
            font-size: 4rem;
        }
    <style>

</BaseLayout>
